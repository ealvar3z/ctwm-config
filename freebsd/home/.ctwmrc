# CTWM Acme desktop for FreeBSD
# Palette:
#   body bg        #FFFFEA
#   body select    #EEEE9E
#   body border    #99994C
#   tag bg         #EAFFFF
#   tag select     #9EEEEE
#   tag border     #8888CC
#   text           #000000

NoDefaults
DontShowWelcomeWindow
RestartPreviousState
DecorateTransients
ShowIconManager
ShowWorkSpaceManager
StartInButtonState
SortIconManager
NoCaseSensitive
NoTitleHighlight
NoGrabServer
RandomPlacement
OpaqueMove
WarpRingOnScreen
WarpUnmapped
CenterFeedbackWindow

MoveDelta 3
ConstrainedMoveTime 250
BorderWidth 2
ThreeDBorderWidth 1
TitleButtonBorderWidth 0
TitleButtonShadowDepth 1
TitleShadowDepth 1
FramePadding 0
TitlePadding 3
ButtonIndent 0
UseThreeDBorders
UseThreeDTitles
UseThreeDMenus
UseThreeDIconManagers
SunkFocusWindowTitle

TitleFont "fixed"
MenuFont "fixed"
IconFont "fixed"
IconManagerFont "fixed"
ResizeFont "fixed"

WorkSpaceManagerGeometry "520x24+10+10" 4
IconManagerGeometry "260x5-10+150" 1
IconRegion "180x540-10+180" South East 80 25

Color
{
        DefaultBackground      "#FFFFEA"
        DefaultForeground      "#000000"

        MenuBackground         "#EAFFFF"
        MenuForeground         "#000000"
        MenuTitleBackground    "#9EEEEE"
        MenuTitleForeground    "#000000"
        MenuShadowColor        "#8888CC"

        BorderColor            "#99994C"
        BorderTileBackground   "#EEEE9E"
        BorderTileForeground   "#99994C"

        TitleBackground        "#EAFFFF"
        TitleForeground        "#000000"

        IconBackground         "#FFFFEA"
        IconForeground         "#000000"
        IconBorderColor        "#99994C"

        IconManagerBackground  "#EAFFFF"
        IconManagerForeground  "#000000"
        IconManagerHighlight   "#8888CC"
}

WorkSpaces
{
        "term"  { "#EAFFFF" "#000000" "#FFFFEA" "#000000" }
        "edit"  { "#EAFFFF" "#000000" "#FFFFEA" "#000000" }
        "web"   { "#EAFFFF" "#000000" "#FFFFEA" "#000000" }
        "misc"  { "#EAFFFF" "#000000" "#FFFFEA" "#000000" }
}

OccupyAll
{
        "xclock"
        "XClock"
        "WorkSpaceManager"
}

IconManagerDontShow
{
        "xclock"
        "XClock"
        "WorkSpaceManager"
}

WindowRing
{
        "XTerm"
        "Acme"
        "Firefox"
}

LeftTitleButton  ":xpm:menu"   = f.menu "rootmenu"
LeftTitleButton  ":xpm:dot"    = f.iconify
RightTitleButton ":xpm:resize" = f.resize
RightTitleButton ":xpm:box"    = f.fullzoom

Button1 =        : root             : f.menu "rootmenu"
Button2 =        : root             : f.menu "windowops"
Button3 =        : root             : f.menu "terminals"
Button1 =        : title            : f.move
Button2 =        : title            : f.raiselower
Button3 =        : title            : f.menu "windowops"
Button1 =        : frame            : f.resize
Button1 =        : icon             : f.iconify
Button1 =        : iconmgr          : f.iconify
Button1 = m      : window | icon    : f.move
Button2 = m      : window | icon    : f.iconify
Button3 = m      : window | icon    : f.resize

"Return" = m     : all : f.exec "xterm -name acme-term &"
"a"      = m     : all : f.exec "9 acme &"
"e"      = m     : all : f.exec "xterm -name acme-term -e ${SHELL:-/bin/sh} &"
"m"      = m     : all : f.menu "rootmenu"
"w"      = m     : all : f.menu "windowops"
"n"      = m     : all : f.nextworkspace
"p"      = m     : all : f.prevworkspace
"Tab"    = m     : all : f.warpring "next"
"Tab"    = m | s : all : f.warpring "prev"
"i"      = m     : all : f.iconify
"f"      = m     : all : f.fullzoom
"s"      = m     : all : f.squeeze
"d"      = m     : all : f.delete
"r"      = m | c : all : f.restart
"q"      = m | c : all : f.quit

"Left"  = m      : all : f.leftworkspace
"Right" = m      : all : f.rightworkspace
"Up"    = m      : all : f.upworkspace
"Down"  = m      : all : f.downworkspace

"h" = m | c : all : f.jumpleft "10"
"j" = m | c : all : f.jumpdown "10"
"k" = m | c : all : f.jumpup "10"
"l" = m | c : all : f.jumpright "10"

menu "rootmenu"
{
        "ctwm / acme"          f.title
        "terminal"             f.exec "xterm -name acme-term &"
        "acme"                 f.exec "9 acme &"
        "sam in xterm"         f.exec "xterm -name acme-term -e 9 sam &"
        "rc shell"             f.exec "xterm -name acme-term -e /usr/local/plan9/bin/rc &"
        "plumber"              f.exec "9 plumber &"
        "xclock"               f.exec "xclock -analog &"
        ""                     f.separator
        "next workspace"       f.nextworkspace
        "previous workspace"   f.prevworkspace
        "workspace map"        f.toggleworkspacemgr
        "icon manager"         f.showiconmgr
        ""                     f.separator
        "identify window"      f.identify
        "refresh"              f.refresh
        "restart ctwm"         f.restart
        "quit X session"       f.quit
}

menu "windowops"
{
        "window"               f.title
        "move"                 f.move
        "resize"               f.resize
        "raise"                f.raise
        "lower"                f.lower
        "raise/lower"          f.raiselower
        "iconify"              f.iconify
        "squeeze"              f.squeeze
        "full zoom"            f.fullzoom
        "horizontal zoom"      f.horizoom
        "vertical zoom"        f.zoom
        "occupy workspaces"    f.occupy
        "occupy all"           f.occupyall
        "delete"               f.delete
        "destroy"              f.destroy
}

menu "terminals"
{
        "terminals"            f.title
        "xterm"                f.exec "xterm -name acme-term &"
        "root shell"           f.exec "xterm -name acme-term -title '# root' -e su - &"
        "top"                  f.exec "xterm -name acme-term -title '+top' -e top &"
        "logs"                 f.exec "xterm -name acme-term -title '+messages' -e tail -f /var/log/messages &"
}
