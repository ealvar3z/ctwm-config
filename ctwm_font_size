set -eu

width=${CTWM_SCREEN_WIDTH:-}
height=${CTWM_SCREEN_HEIGHT:-}
dpi=${CTWM_SCREEN_DPI:-}

is_number()
{
	case $1 in
		''|*[!0-9.]*|.*|*.*.*) return 1 ;;
		*) return 0 ;;
	esac
}

is_integer()
{
	case $1 in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

# Prefer the primary monitor. Using one monitor instead of the full X screen
# avoids treating a side-by-side multi-monitor layout as one high-DPI display.
xrandr_output=${CTWM_XRANDR_OUTPUT:-}
if [ -z "$xrandr_output" ] &&
    { ! is_integer "$width" || ! is_integer "$height" || ! is_number "$dpi"; } &&
    command -v xrandr >/dev/null 2>&1; then
	xrandr_output=$(xrandr --listactivemonitors 2>/dev/null || :)
fi

if [ -n "$xrandr_output" ] &&
    { ! is_integer "$width" || ! is_integer "$height" || ! is_number "$dpi"; }; then
	monitor=$(
		printf '%s\n' "$xrandr_output" |
		    awk '
			NR == 1 { next }
			{
				geometry = $3
				sub(/\+.*/, "", geometry)
				split(geometry, dimensions, "x")
				split(dimensions[1], horizontal, "/")
				split(dimensions[2], vertical, "/")
				if (horizontal[1] <= 0 || vertical[1] <= 0)
					next

				value = horizontal[1] " " vertical[1] " 0"
				if (horizontal[2] > 0 && vertical[2] > 0) {
					dpi = ((horizontal[1] / horizontal[2]) + (vertical[1] / vertical[2])) * 12.7
					value = horizontal[1] " " vertical[1] " " dpi
				}

				if (!first)
					first = value
				if ($2 ~ /\*/) {
					print value
					found = 1
					exit
				}
			}
			END {
				if (!found && first)
					print first
			}
		    '
	)

	if [ -n "$monitor" ]; then
		set -- $monitor
		is_integer "$width" || width=$1
		is_integer "$height" || height=$2
		is_number "$dpi" || dpi=$3
	fi
fi

is_integer "$width" || width=1024
is_integer "$height" || height=768
is_number "$dpi" || dpi=0

# Select the smallest available Spleen size that is at least 3 mm high when
# the server reports a non-default DPI. The largest size remains the fallback
# for unusually dense displays.
if awk -v dpi="$dpi" 'BEGIN { exit !(dpi > 100) }'; then
	awk -v dpi="$dpi" '
		BEGIN {
			sizes[1] = 12
			sizes[2] = 16
			sizes[3] = 24
			sizes[4] = 32
			sizes[5] = 64
			for (i = 1; i <= 5; i++) {
				if ((sizes[i] * 25.4 / dpi) >= 3) {
					print sizes[i]
					exit
				}
			}
			print 64
		}
	'
	exit 0
fi

# If DPI is unavailable or looks like Xorg's default, preserve the NetBSD
# screen-size heuristic. These limits allow at least a 2x2 grid of 80x24
# terminals at each selected bitmap-font size.
if [ "$width" -gt 6088 ] && [ "$height" -gt 3656 ]; then
	printf '64\n'
elif [ "$width" -gt 3048 ] && [ "$height" -gt 1832 ]; then
	printf '32\n'
elif [ "$width" -gt 2248 ] && [ "$height" -gt 1400 ]; then
	printf '24\n'
elif [ "$width" -gt 640 ] && [ "$height" -gt 480 ]; then
	printf '16\n'
else
	printf '12\n'
fi
